{
  "manifest_version": 3,
  "name": "Pygent Browser Agent",
  "version": "1.0.0",
  "description": "Browser automation extension for Pygent",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pygent Control"
  }
}
